{
  "name": "dynamo-processor",
  "version": "4.0.0",
  "description": "DynamoDB operation processor for Node.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test --test-concurrency=1 tests/*.test.ts",
    "coverage": "tsc && node --test --test-concurrency=1 --experimental-test-coverage tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilfin/dynamo-processor.git"
  },
  "keywords": [
    "DynamoDB",
    "operation"
  ],
  "author": "Toshimitsu Takahashi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tilfin/dynamo-processor/issues"
  },
  "homepage": "https://github.com/tilfin/dynamo-processor#readme",
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.730.0",
    "@aws-sdk/lib-dynamodb": "^3.730.0",
    "@aws-sdk/util-dynamodb": "^3.730.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.730.0",
    "@aws-sdk/lib-dynamodb": "^3.730.0",
    "@aws-sdk/util-dynamodb": "^3.730.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
